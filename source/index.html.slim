---
title: Soumya Ray
---

.row
  .col-sm-6
    = partial "partials/current_position"
  .col-sm-6
    = partial "partials/social/contact_me"

span style="display: inline-block;"
  h2 class="h5"
    = "Recent Talks"
span style="display: inline-block; margin-left:10px"
  small
    = link_to "See all talks", "talks.html"
.row
  .col-12
    div class="card"
      div class="card-body"
        - data.talks.talks.first(2).each do |talk|
          p
            - if talk.kind == 'keynote'
              span = "Keynote: "
            i #{talk.title}
            br
            - venue = talk.venues.first
            b #{venue.host}
            span = " – #{venue.year}"

span style="display: inline-block;"
  h2 class="h5"
    = "Publication Highlights"
span style="display: inline-block; margin-left:10px"
  small
    = link_to "See all papers", "research.html"
- pubs = data.journal_papers
- highlights = pubs.papers.select { |p| pubs.highlights.include? p.id }
- highlights.first(2).each do |paper|
  .row
    .col-12
      div class="card"
        div class="card-body"
          .row
            .col-12
              = partial("partials/img_thumb_modal", locals: {dir: 'images/papers', id: paper.id, img: 'figure'})
              span.paper.title #{paper.title}
              br
              i #{paper.journal}
              br
              span #{paper.abstract}

span style="display: inline-block;"
  h2 class="h5"
    = "Popular Courses"
span style="display: inline-block; margin-left:10px"
  small
    = link_to "See all courses", "courses.html"
.row
  - instr = data.instruction
  - highlights = instr.courses.select { |c| instr.highlights.include? c.id }
  - highlights.first(2).each do |course|
    .col-md-6
      div class="card"
        div class="card-body"
          .row
            .col-12
              span.class.title #{course.name}
              br
          .row
            .col-6
              span #{course.short_description}
            .col-6
              = partial("partials/img_thumb_modal", locals: {dir: 'images/courses', id: course.id, img: 'figure'})
