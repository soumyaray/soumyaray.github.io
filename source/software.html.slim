h1.section_title Software Packages

- data.software.packages.each do |package|
  div class="card"
    div class="card-header"
      h2.card-title #{package.name}
    div class="card-body"
      .row
        .col-md-12
          - if package.logo
            img.right.small src="images/software/#{package.id}/logo.png"
          = package.description
    div class="card-footer"
      .row
        - [["Homepage", "fa-solid fa-house", package.home_url],
           ["Source Code", "fa-brands fa-github", package.git_url],
           ["Manual", "fa-solid fa-book", package.manual],
           ["Book", "fa-solid fa-book-open", package.book_url],
           ["Videos", "fa-brands my-fa-youtube", package.video_url]].each do |name, icon, data|
          - if data
            .col-6.col-md-4
              i class="#{icon}" aria-hidden="true" style="margin-right:5px"
              a href="#{data}" #{name}
